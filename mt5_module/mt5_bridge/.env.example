# Optional explicit terminal path. Leave blank to let MetaTrader5 auto-detect MT5.
# Example: C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_TERMINAL_PATH=
MT5_IPC_TIMEOUT_MS=20000

# Local-only bridge settings. Keep host on 127.0.0.1 unless you intentionally secure remote access.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8000

# Separate local EA worker coordinated by this bridge.
MT5_EA_WORKER_URL=http://127.0.0.1:8001

# DEMO accounts can trade when connected. LIVE accounts are blocked unless this is explicitly changed to 1.
MT5_ALLOW_LIVE_TRADING=0

# Order defaults.
MT5_DEVIATION_POINTS=20
MT5_MAGIC=510999
MT5_HISTORY_DAYS=30
