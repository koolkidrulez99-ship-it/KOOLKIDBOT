# Build the React Hub under the Flask /mt5-bot route.
VITE_ROUTER_BASE=/mt5-bot
VITE_ASSET_BASE=/mt5-bot/
VITE_HOST_HOME_URL=/

# LOCAL WINDOWS development with the bridge running on this same laptop:
VITE_MT5_MODE=bridge
VITE_MT5_API_BASE=http://127.0.0.1:8000
VITE_MT5_MULTI_ACCOUNT_API_BASE=http://127.0.0.1:8002

# Keep 0 unless the official TradingView Advanced Charts library has been supplied by its license holder.
VITE_TRADINGVIEW_ADVANCED=0
